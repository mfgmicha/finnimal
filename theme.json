{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "light-dark(#111111, #E2D9CA)",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "light-dark(#E2D9CA, #111111)",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "light-dark(#936A0B,#FFC067)",
					"name": "Accent 1",
					"slug": "accent-1"
				},
				{
					"color": "light-dark(#FFC067,#936A0B)",
					"name": "Accent 2",
					"slug": "accent-2"
				},
				{
					"color": "#574407",
					"name": "Accent 3",
					"slug": "accent-3"
				},
				{
					"color": "#E2D9CA",
					"name": "Accent 4",
					"slug": "accent-4"
				},
				{
					"color": "#686868",
					"name": "Accent 5",
					"slug": "accent-5"
				},
				{
					"color": "color-mix(in srgb, currentColor 20%, transparent)",
					"name": "Accent 6",
					"slug": "accent-6"
				}
			]
		},
		"layout": {
			"contentSize": "645px",
			"wideSize": "1340px"
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Oxygen-Sans,Ubuntu,Cantarell, \"Helvetica Neue\",sans-serif",
					"slug": "sans-serif",
					"name": "Sans Serif"
				}
			]
		}
	},
	"styles": {
		"css": ":root { color-scheme: light dark; }",
		"color": {
			"background": "var:preset|color|contrast",
			"text": "var:preset|color|base"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans-serif",
			"fontWeight": "300",
			"lineHeight": "1.4",
			"letterSpacing": "-0.1px"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|accent-1"
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "300",
					"lineHeight": "1.4",
					"letterSpacing": "-0.1px"
				}
			}
		}
	}
}
